rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function isValidWorkspace(data) {
      return data.keys().hasAll([
          'ownerId',
          'displayName',
          'profile',
          'orchestration',
          'roles',
          'mentorMessages',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'displayName',
          'profile',
          'orchestration',
          'roles',
          'mentorMessages',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.profile is map
        && data.orchestration is map
        && data.roles is list
        && data.roles.size() <= 25
        && (data.roles.size() == 0 || data.roles[0] is map)
        && data.mentorMessages is list
        && data.mentorMessages.size() <= 150
        && (data.mentorMessages.size() == 0 || data.mentorMessages[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /workspaces/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidWorkspace(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidWorkspace(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'profile',
          'orchestration',
          'roles',
          'mentorMessages',
          'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
